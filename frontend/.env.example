# ---------------------------------------------------------------------------
# Groq credentials — https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_key_here

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Caption-rewrite chain: the FIRST model that answers is reused for the whole
# job.  llama-3.3-70b-versatile was decommissioned on 2026-08-16, which is why
# it must not be first in this list.  Check live ids: GET /api/diagnose
GROQ_LLM_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Speech-to-text model + fallback
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_WHISPER_FALLBACK_MODELS=whisper-large-v3-turbo

# ---------------------------------------------------------------------------
# Uploads / chunking
# ---------------------------------------------------------------------------
# Groq free tier caps a request at 25 MB (Developer tier: 100 MB).
# 20 MB of 16 kHz mono PCM is ~10 minutes of audio.
GROQ_MAX_AUDIO_BYTES=20971520
# 0 = derive the chunk length from GROQ_MAX_AUDIO_BYTES
GROQ_CHUNK_SECONDS=0
GROQ_CHUNK_OVERLAP_SECONDS=1.0
# Free-tier gpt-oss is limited to 8 000 tokens/minute -> keep batches small.
GROQ_LLM_BATCH_WORDS=40
# Retries per request before giving up (429s / 5xx are retried with backoff)
GROQ_WHISPER_ATTEMPTS=4
GROQ_LLM_ATTEMPTS=4
# Refuse to process clips longer than this (4 h default)
GROQ_MAX_AUDIO_SECONDS=14400

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=1536
TRANSCRIBE_CONCURRENCY=2
# Comma-separated. Any localhost/127.0.0.1 port is allowed by regex anyway.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
LOG_LEVEL=INFO
# DEBUG=1 adds tracebacks + details to JSON error responses
DEBUG=0
# UPLOAD_DIR=/absolute/path/to/uploads
